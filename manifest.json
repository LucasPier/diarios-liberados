      "js": [
        "js/clarin-suscriptores.js"
      ],
      "css": [
        "css/clarin-publicidad.css",
        "css/clarin-suscriptores.css"
      ],
      "matches": [
        "*://*.clarin.com/*",
        "*://*.ole.com.ar/*"
      ],
      "run_at": "document_start"
    },
